{
  "name": "aerothermo-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "AeroThermo Lab: an educational 2-D compressible-flow, aerodynamic-heating and heat-shield conduction simulator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
